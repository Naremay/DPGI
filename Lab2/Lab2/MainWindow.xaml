<Window x:Class="Lab2.MainWindow"  
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
       xmlns:local="clr-namespace:Lab2"  
       mc:Ignorable="d"  
       Title="TextEditor" Height="450" Width="800">  
   <Grid>  
       <Grid.RowDefinitions>  
           <RowDefinition Height="Auto"></RowDefinition>  
           <RowDefinition></RowDefinition>  
       </Grid.RowDefinitions>  
       <StackPanel Orientation="Horizontal" Grid.Row="0" Height="60">  
           <Button>  
               <Image Source="images/image_1.png" />  
           </Button>  
           <Button>
                <Image Source="images/image_2.png"/>  
           </Button>  
           <Button>
                <Image Source="images/image_3.png"/>  
           </Button>  
           <Button>
                <Image Source="images/image_4.png" />  
           </Button>  
       </StackPanel>  
       <Border Grid.Row="0" BorderBrush="DarkOrange" BorderThickness="2" CornerRadius="10"></Border>
        <Border Grid.Row="1" BorderBrush="DarkOrange" BorderThickness="2" CornerRadius="10"></Border>  
       <Grid Grid.Row="1" Margin="30">  
           <Grid.RowDefinitions>  
               <RowDefinition></RowDefinition>  
               <RowDefinition Height="Auto"></RowDefinition>  
           </Grid.RowDefinitions>  
           <ScrollViewer>  
               <TextBox Grid.Row="0" Text="Write your text here" TextWrapping="Wrap"></TextBox>  
           </ScrollViewer>  
           <DockPanel Grid.Row="1" Margin="0,20,0,0">  
               <Button  DockPanel.Dock="Bottom" Width="20">Ok</Button>  
           </DockPanel>  
       </Grid>  
   </Grid>  
</Window>
